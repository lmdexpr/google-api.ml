# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Google sign-in (OpenID Connect) and OAuth 2.0 tokens"
description: """
Authorization URLs, code exchange with ID token validation and token refresh for
Google accounts. HTTP goes through the google-api effect."""
maintainer: ["Yuki Tajiri"]
authors: ["Yuki Tajiri"]
license: "MIT"
homepage: "https://github.com/lmdexpr/google-api.ml"
bug-reports: "https://github.com/lmdexpr/google-api.ml/issues"
depends: [
  "ocaml" {>= "5.5.0"}
  "dune" {>= "3.23"}
  "google-api" {= version}
  "oidc" {>= "0.2.0"}
  "jose" {>= "0.11.0"}
  "digestif"
  "base64"
  "uri"
  "yojson"
  "alcotest" {with-test}
  "mirage-crypto-pk" {with-test}
  "mirage-crypto-rng" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lmdexpr/google-api.ml.git"
x-maintenance-intent: ["(latest)"]
