(library
 (name google_api_cloudkms)
 (public_name google-api-cloudkms)
 (libraries google-api google-api.runtime uri yojson))

(rule
 (targets google_api_cloudkms.ml.gen google_api_cloudkms.mli.gen)
 (deps
  (:discovery %{project_root}/discovery/cloudkms.v1.json))
 (action
  (run %{exe:../../gen/main.exe} %{discovery} %{targets})))

(rule
 (alias runtest)
 (action
  (diff google_api_cloudkms.ml google_api_cloudkms.ml.gen)))

(rule
 (alias runtest)
 (action
  (diff google_api_cloudkms.mli google_api_cloudkms.mli.gen)))
