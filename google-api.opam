# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Google APIs: HTTP effect, errors, calls and batch requests"
description: """
Transport-independent core shared by the generated Google API packages.
HTTP goes through a single effect; see google-api-cohttp-eio for a handler."""
maintainer: ["Yuki Tajiri"]
authors: ["Yuki Tajiri"]
license: "MIT"
homepage: "https://github.com/lmdexpr/google-api.ml"
bug-reports: "https://github.com/lmdexpr/google-api.ml/issues"
depends: [
  "ocaml" {>= "5.5.0"}
  "dune" {>= "3.23"}
  "yojson"
  "uri"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lmdexpr/google-api.ml.git"
x-maintenance-intent: ["(latest)"]
