# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Cohttp-eio handler for google-api"
description: "Handles the google-api HTTP effect with a cohttp-eio client."
maintainer: ["Yuki Tajiri"]
authors: ["Yuki Tajiri"]
license: "MIT"
homepage: "https://github.com/lmdexpr/google-api.ml"
bug-reports: "https://github.com/lmdexpr/google-api.ml/issues"
depends: [
  "ocaml" {>= "5.5.0"}
  "dune" {>= "3.23"}
  "google-api" {= version}
  "eio"
  "cohttp-eio"
  "http"
  "eio_main" {with-test}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lmdexpr/google-api.ml.git"
x-maintenance-intent: ["(latest)"]
