(library
 (name google_api_run)
 (public_name google-api-run)
 (libraries google-api google-api.runtime uri yojson))

(rule
 (targets google_api_run.ml.gen google_api_run.mli.gen)
 (deps
  (:discovery %{project_root}/discovery/run.v2.json))
 (action
  (run %{exe:../../gen/main.exe} %{discovery} %{targets})))

(rule
 (alias runtest)
 (action
  (diff google_api_run.ml google_api_run.ml.gen)))

(rule
 (alias runtest)
 (action
  (diff google_api_run.mli google_api_run.mli.gen)))
