(library
 (name google_api_storage)
 (public_name google-api-storage)
 (libraries google-api google-api.runtime uri yojson))

(rule
 (targets google_api_storage.ml.gen google_api_storage.mli.gen)
 (deps
  (:discovery %{project_root}/discovery/storage.v1.json))
 (action
  (run %{exe:../../gen/main.exe} %{discovery} %{targets})))

(rule
 (alias runtest)
 (action
  (diff google_api_storage.ml google_api_storage.ml.gen)))

(rule
 (alias runtest)
 (action
  (diff google_api_storage.mli google_api_storage.mli.gen)))
